{
  "name": "pi-loop-guard",
  "version": "0.1.0",
  "description": "Pi coding agent extension that stops the agent when the model gets stuck in a loop (repeated tool calls or repetitive output)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "loop-detection",
    "local-llm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^26.4.0",
    "typescript": "^5.8.2"
  }
}
